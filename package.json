{
  "name": "hrtech-site",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify",
    "verify": "node scripts/verify-build.mjs",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "next": "^15.5.28",
    "react": "19",
    "react-dom": "19"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "9",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "simple-icons": "^16.32.0",
    "tailwindcss": "3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.30",
      "source-map-js": ">=1.2.2"
    }
  }
}
