PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://hrtech:hrtech_dev_password@localhost:5432/hrtech?schema=public"

# Formulário de contato (Azure Communication Services — Email)
# Sem estas variáveis, o endpoint POST /contact responde 503 (serviço de e-mail não configurado).
AZURE_COMMUNICATION_CONNECTION_STRING=
CONTACT_SENDER_EMAIL=
CONTACT_RECIPIENT_EMAIL=contato@hrtechsistemas.com.br
