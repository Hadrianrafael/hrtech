{
  "name": "HR Tech — Agendador do worker da Equipe IA",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "ad8a8d44-0617-5401-a023-df9dbeb75013",
      "name": "A cada 2 minutos",
