      "parameters": {
        "jsCode": "// Uma mensagem por contato. WhatsApp: template aprovado (fora da janela de 24h só templates são permitidos).\nconst d = $json.data || {};\nconst text = d.message || 'Olá! Passando para saber se posso ajudar com o seu atendimento.';\nreturn (d.contacts || []).map((c) => ({ json: { contactId: c.id, name: c.name, phone: (c.whatsapp || c.phone || '').replace(/\\D/g, ''), email: c.email || null, sequence: d.sequence, text } }));"
      },
