    {
      "parameters": {
        "jsCode": "// Monta o retorno para a HR Tech, assinado com o mesmo segredo (HMAC-SHA256 sobre \"<t>.<corpo>\").\nconst crypto = require('crypto');\nconst secret = $env.HRTECH_WEBHOOK_SECRET;\nconst req = $('Verificar assinatura').first().json;\nconst payload = JSON.stringify({\n  eventId: `${req.id}:completed`,\n  dispatchId: req.id,\n  idempotencyKey: req.idempotencyKey,\n  status: 'completed',\n  result: $json,\n  error: undefined,\n});\nconst t = Math.floor(Date.now() / 1000);\nconst signature = `t=${t},v1=${crypto.createHmac('sha256', secret).update(`${t}.${payload}`).digest('hex')}`;\nreturn [{ json: { callbackUrl: req.callbackUrl, payload, signature } }];"
      },
      "id": "f833f7ec-86fb-560f-8a22-83d4a5aade7c",
      "name": "Assinar retorno",
