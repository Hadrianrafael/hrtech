# ─────────────────────────────────────────────────────────────────────────────
# HR Tech Platform — variáveis de ambiente (copie para .env e preencha).
# NUNCA versione o arquivo .env nem coloque valores reais neste exemplo.
# ─────────────────────────────────────────────────────────────────────────────

# Banco PostgreSQL. As migrations criam o papel restrito "hrtech_rls" (requer CREATEROLE), usado em todas as
# transações para garantir o Row-Level Security mesmo se o usuário de conexão tiver BYPASSRLS (ex.: Neon).
DATABASE_URL=postgresql://hrtech:SENHA@localhost:5432/hrtech
# Conexão direta (sem pooler) para migrations, quando DATABASE_URL usa pooler. Na Vercel+Neon a integração
# já cria DATABASE_URL_UNPOOLED, usada automaticamente.
DIRECT_URL=
# Banco exclusivo para testes de integração (pnpm test). Opcional.
TEST_DATABASE_URL=postgresql://hrtech:SENHA@localhost:5432/hrtech_test

# URL pública da aplicação (links de convite, webhooks e widget). Na Vercel, se vazia, usa o domínio de produção.
APP_URL=http://localhost:3000

# Segredo do servidor (mín. 32 caracteres) — protege os hashes de tokens de sessão/convite/senha.
# Gere com: openssl rand -base64 48
AUTH_SECRET=

# Chave de criptografia das credenciais de integrações (AES-256-GCM): 32 bytes em base64.
# Gere com: openssl rand -base64 32   (trocar esta chave invalida as credenciais já salvas)
ENCRYPTION_KEY=

# Protege a rotina periódica /api/cron/tick (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Fuso padrão para datas renderizadas no servidor.
APP_TIMEZONE=America/Sao_Paulo

# ── Inteligência Artificial (PENDENTE DE CREDENCIAL) ──
# Provedor padrão do chatbot e dos agentes em "auto": openai | anthropic | gemini.
# Sem AI_PROVIDER, usa o primeiro que tiver chave. Cada agente da Equipe IA pode usar outro provedor/modelo.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Opcional: endpoint compatível com OpenAI (ex.: Azure OpenAI via proxy)
OPENAI_BASE_URL=
# Anthropic (Claude) — SDK oficial; modelo padrão claude-opus-5-5 (configurável por agente)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_BASE_URL=
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=
# Opcional: tabela de preços (US$ por 1M tokens) para estimar custos: {"claude-opus-5-5":[4,20]}
AI_PRICING_JSON=

# ── n8n — automações externas da Equipe IA (PENDENTE DE CREDENCIAL) ──
# URL base do seu n8n (ex.: https://n8n.seudominio.com.br). Os envios vão para <N8N_BASE_URL>/webhook/hrtech-dispatcher.
N8N_BASE_URL=
# Segredo compartilhado (HMAC-SHA256) usado nos dois sentidos — gere com: openssl rand -hex 32
N8N_WEBHOOK_SECRET=
# Opcional: chave da API REST do n8n (consulta de execuções)
N8N_API_KEY=
N8N_TIMEOUT_MS=15000

# ── Meta: WhatsApp Business Platform (Cloud API) e Instagram (pendente de credencial) ──
# Credenciais por empresa (Phone Number ID, token) são cadastradas na tela Integrações (criptografadas).
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
# Instagram API com login do Instagram usa o "Instagram App Secret" (diferente do App Secret do app Meta) para assinar
# os webhooks. Se vazio, a assinatura do Instagram é verificada com META_APP_SECRET.
INSTAGRAM_APP_SECRET=

# ── E-mail transacional da plataforma (convites e redefinição de senha) ──
# Sem SMTP, os links aparecem na tela/console em ambiente de desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="HR Tech <no-reply@seudominio.com.br>"

# ── Billing (manual | stripe | asaas) ──
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ── Seed (pnpm db:seed — idempotente; na Vercel roda a cada deploy de produção) ──
# Banco remoto: obrigatórios no PRIMEIRO deploy para criar o Super Admin HR Tech (depois podem ser removidos).
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
# Senha do primeiro administrador (mín. 8 caracteres, letras e números). Banco local: padrão Demo@12345.
SEED_PASSWORD=
# Dados fictícios de demonstração ("Pousada Exemplo"). Padrão: true em banco local, false em banco remoto.
SEED_DEMO=

# ── Vercel ──
# Em Preview, as migrations só rodam se este ambiente tiver banco próprio e MIGRATE_ON_BUILD=true.
MIGRATE_ON_BUILD=
